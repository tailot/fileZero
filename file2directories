const fs = require("fs");

// Check for filename argument
if (process.argv.length < 3 || !process.argv[2]) {
    console.error('Usage: ./file2directories.js <filename> [slice_length]\n  <filename>      : The file to be processed.\n  [slice_length]  : Optional. Positive integer for chunk size (default: 130).');
    process.exit(1);
}
const filename = process.argv[2];

// Validate filename
if (!fs.existsSync(filename) || !fs.lstatSync(filename).isFile()) {
    console.error('Error: File not found or is not accessible.');
    console.error('Usage: ./file2directories.js <filename> [slice_length]\n  <filename>      : The file to be processed.\n  [slice_length]  : Optional. Positive integer for chunk size (default: 130).');
    process.exit(1);
}

// Parse and validate slice_length argument
let sliceValue;
if (process.argv[3] !== undefined) {
    const parsedSlice = parseInt(process.argv[3]);
    if (Number.isInteger(parsedSlice) && parsedSlice > 0) {
        sliceValue = parsedSlice;
    } else {
        console.error('Error: slice_length must be a positive integer.');
        console.error('Usage: ./file2directories.js <filename> [slice_length]\n  <filename>      : The file to be processed.\n  [slice_length]  : Optional. Positive integer for chunk size (default: 130).');
        process.exit(1);
    }
} else {
    sliceValue = 130; // Default value
}
const regslice = new RegExp(`.{1,${sliceValue}}`, 'g');

const createLoopDir = async (str) => {
    const sp = str.replace(/\//g, '|');
    fs.mkdirSync(sp);
    process.chdir(sp);
}
fs.readFile(filename, (err, data) => {
    if (err) {
        console.error('Error: File not found or is not accessible.');
        throw err;
    }
    const dn = `_${filename.replace(/\//g, '')}`;
    if (!fs.existsSync(dn)) {
        fs.mkdirSync(dn);
        process.chdir(dn);
    }
    
    const f = Buffer.from(data).toString('base64').match(regslice); // Using Buffer.from()

    f.forEach((element) => {
        createLoopDir(element);
    });
});
