#!/usr/bin/env node
var fs = require("fs");

function createLoopDir(base, str) {
    const sp = str.split('/');
    let acc = '';
    sp.forEach((elem) => {
        if (elem === '') {
            acc = `${acc}_/`;
        } else {
            acc = `${acc}${elem}/`;
        }
        if (!fs.existsSync(`${base}/${acc}`)) {
            fs.mkdirSync(`${base}/${acc}`);
        }
    });
}

fs.readFile(process.argv[2], "utf8", function (err, data) {
    if (err) throw err;
    const dn = `_${process.argv[2]}`;
    if (!fs.existsSync(dn)) {
        fs.mkdirSync(dn);
    }
    const f = Buffer.from(data, 'binary').toString('base64').match(/.{1,130}/g);
    if (fs.existsSync(f[0])) { return false; }
    f.forEach((element, index) => {
        createLoopDir(dn, `${index}/${element}`);
    });
    return true;
});
