#!/usr/bin/env node
var fs = require("fs");
const nameFile = process.argv[2];
const currDir = process.cwd();

function readLoopDir(dir, prev, acc) {
    const _acc = `${acc}/${dir}`;
    fs.readdir(prev, (err, files) => {
        if (err) throw err;
        if (files.length === 0) {
            const data = _acc.replace(`/${nameFile}/`, '').replace(/\//g, '').replace(/\|/g, '/');
            const p = new Buffer.from(data, 'base64').toString('binary');
            process.chdir(currDir);

            fs.writeFile(
                `new_${nameFile}`,
                p, 'binary', (err) => {
                    if (err) throw err;
                });

        }
        files.filter(ch => {
            if (fs.existsSync(`${prev}/${ch}`)) {
                process.chdir(dir);
                readLoopDir(ch, files[0], _acc);
            }
        });
    })
}

readLoopDir(nameFile, nameFile, '');

